#include <iostream>
using namespace std;
struct DynArray {
	int* data;
	int size;
	int capacity;

};
void initArray(DynArray* arr, int cap) {
	arr->data = new int[cap];
	arr->size = 0;
	arr->capacity = cap;

}
void freeArray(DynArray* arr) {
	delete[] arr->data;
	arr->data = nullptr;
	arr->size = 0;
	arr->capacity = 0;
}
void append(DynArray* arr, int val) {
	if (arr->size == arr->capacity) {

		int newCap = arr->capacity * 2;
		int* newData = new int[newCap];
		for (int i = 0; i < arr->size; i++) {
			newData[i] = arr->data[i];
		}


	}
	arr->data[arr->size++] = val;

}

int main() {
	DynArray myVec;
	initArray(&myVec, 2);
	for (int i = 1; i <= 5; i++) {
		append(&myVec, i * 10);
		freeArray(&myVec);
		return 0;
	}
	
}
