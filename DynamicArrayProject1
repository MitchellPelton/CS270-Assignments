#include <iostream>
using namespace std;
struct DynArray {
	int* data;
	int size;
	int capacity;

};

void initArray(DynArray* arr, int cap) {
	arr->data = new int[cap];
	for(int i = 0; i < cap; i++) {
		arr->data[i] = (i+1)*10;
	}
	arr->size = cap;
	arr->capacity = cap;
	//cout << arr->data[1] << endl;

}

void freeArray(DynArray* arr) {
	delete[] arr->data;
	arr->data = nullptr;
	arr->size = 0;
	arr->capacity = 0;
}

void append(DynArray* arr, int newSize) {

	int* newData = new int[newSize];
	for (int i = 0; i < 2; i++) {
		newData[i] = arr->data[i];
	}
	for(int i=arr->size; i<newSize;i++){
		newData[i] = (i+1)*10;
	}
	delete[] arr->data;
	arr->data = newData;
	arr->size = newSize;
	arr->capacity = newSize;
}

void printArray(DynArray* arr) {
	for (int i = 0; i < arr->size; i++) {
		cout << arr->data[i] << " ";
	}
	cout << endl;
}

int main() {
	DynArray myVec;
	
	initArray(&myVec, 2);

	printArray(&myVec);
	
	append(&myVec, 22);

	printArray(&myVec);

	freeArray(&myVec);
	
}
