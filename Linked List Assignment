#include <iostream>

using namespace std;

//Insert Data into a linked list
class Node {

public:
	int data;
	Node* next;
	Node(int data) {
		this->data = data;
		next = NULL;
	}
};
//Insert data at the start of the linked list
void insertAtStart(Node*& head, int data) {
	Node* newNode = new Node(data);
	newNode->next = head;
	head = newNode;
}
//Insert data at the end of the linked list
void insertAtEnd(Node*& tail, int data) {

	Node* newNode = new Node(data);
	tail->next = newNode;
	tail = tail->next;


}
//Inset data at a specific position in the linked list
void insertAtPosition(Node*& head, int position, int data) {
	if (position == 1) {
		insertAtStart(head, data);
		return;
	}
	Node* temp = head;
	int count = 1;
	while (count < position - 1 && temp != NULL) {
		temp = temp->next;
		count++;
	}
	if (temp == NULL) {
		cout << "Address does not exist" << endl;
		return;
	}
	Node* newNode = new Node(data);
	newNode->next = temp->next;
	temp->next = newNode;
}
//Traverse the linked list
void traverseLL(Node* head) {
	Node* temp = head;
	while (temp != NULL) {
		cout << temp->data << " -> ";
		temp = temp->next;

	}
}
//Main function, implements all methods and traverses the linked list
int main() {

	Node* node1 = new Node(20);
	Node* head = node1;
	Node* tail = node1;
	insertAtStart(head, 30);
	insertAtStart(head, 50);
	insertAtEnd(tail, 10);
	insertAtPosition(head, 3, 100);
	traverseLL(head);
	
}
