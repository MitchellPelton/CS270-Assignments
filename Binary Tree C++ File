#include <iostream>
#include "BinaryTree.h"
#include "Node.h"
using namespace std;
//Ways to traverse a binary search tree are: Inorder, Preorder, Postorder, Level Order
// Inorder Traversal: a+b, left , root, right
// Preorder Traversal: +ab, root, left, right
// Postorder Traversal: ab+, left, right, root
BinaryTree::BinaryTree() {
	root = nullptr;

}

void BinaryTree::preorder(Node*p)const {
if (p==nullptr){
	return;
	cout << p->info << " ";
	preorder(p->lchild);
	preorder(p->rchild);
}
}
void BinaryTree::inorder(Node* p)const {
	if (p == nullptr) {
		return;
		inorder(p->lchild);
		cout << p->info << " ";
		inorder(p->rchild);
	}
}
void BinaryTree::postorder(Node* p)const {
	if (p == nullptr) {
		return;
		postorder(p->lchild);
		postorder(p->rchild);
		cout << p->info << " ";
	}
}
void BinaryTree::CreateTree() {

	root = new Node('P');
	root->lchild = new Node('Q');
	root->rchild = new Node('R');
	root->lchild->lchild = new Node('A');
	root->lchild->rchild = new Node('B');
	root->rchild->lchild = new Node('X');
}
