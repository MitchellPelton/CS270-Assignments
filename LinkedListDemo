#include <iostream>

using namespace std;

//Insert Data into a linked list
class Node {

public:
	int data;
	Node* next;
	Node(int data) {
		this->data = data;
		next = NULL;
	}
};
//Insert data at the start of the linked list
void insertAtStart(Node*& head, int data) {
	Node* newNode = new Node(data);
	newNode->next = head;
	head = newNode;
}

void insertAtEnd(Node*& tail, int data) {

	Node* newNode = new Node(data);
	tail->next = newNode;
	tail = tail->next;


}

void traverseLL(Node* head) {
	Node* temp = head;
	while (temp != NULL) {
		cout << temp->data << " -> ";
		temp = temp->next;

	}
}

int main() {

	Node* node1 = new Node(20);
	Node* head = node1;
	Node* tail = node1;
	insertAtStart(head, 30);
	insertAtStart(head, 50);
	insertAtEnd(tail, 10);
	traverseLL(head);





}
