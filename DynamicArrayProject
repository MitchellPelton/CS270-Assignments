#include <iostream>
// Standalone function to print an array using pointer arithmetic
void printArray(int* arr, int size) {
	for (int i = 0; i < size; i++) {
		// Using pointer arithmetic instead of array indexing (arr[i])
		std::cout << *(arr + i) << " ";
	}
	std::cout << "\n";
}
int main() {
	int size = 5;
	// 1. Allocate memory on the Heap
	int* myArray = new int[size];
	// 2. Populate the array
	for (int i = 0; i < size; i++) {
		myArray[i] = (i + 1) * 10;
	}
	// 3. Pass the pointer to a standalone function
	printArray(myArray, size);
	// 4. De-allocate memory (Crucial for Outcome 1)
	delete[] myArray;
	myArray = nullptr; // Prevent dangling pointer
	return 0;
}
