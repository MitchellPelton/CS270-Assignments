#include <iostream>
#include <map>
#include <string>
using namespace std;

int main() {
	string input;
	cout << "Enter a string: ";
	getline(cin, input);

	map<string, int> FreqOfWord;
	string word = "";

	// Go through each character of the input
	for (int i = 0; i < input.length(); i++)
	{
		char c = input[i];

		if (c == ' ')
		{
			// A space means the current word has ended
			if (word != "")
			{
				FreqOfWord[word]++; //populating the map
				word = "";
			}
		}
		else
		{
			// Otherwise keep building the current word
			word = word + c;
		}
	}

	// Add the last word (there is no space after it)
	if (word != "")
	{
		FreqOfWord[word]++;
	}

	cout << "All word count: " << endl;

	for (const auto& pair : FreqOfWord)
	{
		cout << "Word " << pair.first << " appears: " << pair.second << " times" << endl;
	}

	string target;
	cout << "Enter a word to look up: ";
	cin >> target;
	cout << "Specific lookup: " << "The word " << target << " appears " << FreqOfWord[target] << " times " << endl;

	return 0;
}
