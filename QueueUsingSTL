#include <iostream>
#include<queue>
using namespace std;
int main(){
	queue<int> q;

	if (q.empty())
	{
		cout << "Queue is empty" << endl;
	}
	cout << "Size of the queue is :" << q.size() << endl;

	//Enqueue()- adding elements into the Queue
	q.push(10);
	q.push(12);
	q.push(15);



	if (q.empty())
	{
		cout << "Queue is empty" << endl;
	}
	cout << "Size of the queue is :" << q.size() << endl;
	//Dequeue()- removing elements from the Queue
	q.pop();
	cout << "Size of the queue is :" << q.size() << endl;
	cout << "Which value is at the front of the queue: " << q.front() << endl; 
	cout << " Which value is in the rear of the queue: " << q.back() << endl;
}
